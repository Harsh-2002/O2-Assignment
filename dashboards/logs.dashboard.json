            {
              "query": "SELECT histogram(_timestamp, '1 minute') AS x_axis_1, sum(length(concat('{', '\"_timestamp\":', cast(\"_timestamp\" AS VARCHAR), ',', '\"cluster\":\"', cast(\"cluster\" AS VARCHAR), '\"', ',', '\"level\":\"', cast(\"level\" AS VARCHAR), '\"', ',', '\"message\":\"', cast(\"message\" AS VARCHAR), '\"', ',', '\"run_id\":\"', cast(\"run_id\" AS VARCHAR), '\"', ',', '\"sequence\":', cast(\"sequence\" AS VARCHAR), ',', '\"service\":\"', cast(\"service\" AS VARCHAR), '\"', ',', '\"synthetic\":', cast(\"synthetic\" AS VARCHAR), ',', '\"timestamp\":\"', cast(\"timestamp\" AS VARCHAR), '\"', '}'))) * 60.0 / 1000000000 AS y_axis_1 FROM \"assignment_logs\" WHERE run_id='load-20260911' GROUP BY x_axis_1 ORDER BY x_axis_1",
